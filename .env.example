# Example environment variables for docker-compose
# Copy to .env and customize if desired

# MySQL
MYSQL_ROOT_PASSWORD=example_password

# Spring Boot datasource
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/job_mgt?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=example_password

# JWT secret (change in production)
JWT_SECRET=ChangeThisSecretKeyForDemo_ChangeMe
